# Content Factory 2.0 Credentials
# Telegram (user account, reads source channels)
TG_API_ID=12345
TG_API_HASH=your_api_hash
TG_SESSION_STRING=your_string_session
TG_SOURCE_CHANNELS=@source1,@source2

# Telegram (bot, publishes to your channel; the bot must be an admin there)
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHANNEL_ID=@your_channel

# Reddit
REDDIT_CLIENT_ID=your_id
REDDIT_CLIENT_SECRET=your_secret
REDDIT_USER_AGENT="ContentFactory/2.0"
REDDIT_SUBREDDITS=gaming,Games

# AI Keys
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...
# Optional model overrides
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_MODEL=gemini-flash-latest

# Database
# Format: postgresql+asyncpg://user:pass@localhost:5432/dbname
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/content_factory
# Password for the docker-compose db container (set before the first start: an existing volume keeps its old password)
POSTGRES_PASSWORD=change_me

# Publishing retries (optional)
# PUBLISH_MAX_ATTEMPTS=5
# PUBLISH_RETRY_BASE=30
